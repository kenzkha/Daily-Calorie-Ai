# GROQ_API_KEY: API Key Groq untuk analisis gambar makanan, perhitungan nutrisi, dan chat asisten kesehatan Jarvis (Dapatkan gratis di https://console.groq.com/keys)
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: (Opsional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

